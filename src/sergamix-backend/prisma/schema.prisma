generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Locacao {
  id                  Int             @id @default(autoincrement())
  nomeObra            String
  responsavelObra     String
  telefoneResponsavel String
  dataInicio          DateTime
  dataFim             DateTime
  status              String          @default("Ativa")
  valorTotal          Float
  numeroOrdemCompra   String?
  numeroContrato      String?
  tipoPeriodicidade   String?
  fornecedor          String?
  itens               ItemLocacao[]
  itensDevolvidos     ItemDevolvido[]
}

model ItemLocacao {
  id              Int     @id @default(autoincrement())
  nomeEquipamento String
  quantidade      Int
  locacaoId       Int
  locacao         Locacao @relation(fields: [locacaoId], references: [id], onDelete: Cascade)
}

model ItemDevolvido {
  id              Int      @id @default(autoincrement())
  nomeEquipamento String
  quantidade      Int
  dataDevolucao   DateTime @default(now())
  locacaoId       Int
  locacao         Locacao  @relation(fields: [locacaoId], references: [id], onDelete: Cascade)
}